# Gemini(Antigravity CLI) 인스턴스용 — .env.gemini로 복사해 채우세요.
# codex 인스턴스(.env)와 별도의 봇 계정·데이터 폴더로 병행 실행된다: npm run start:gemini

# Gemini Bot 전용 토큰 (codex 봇과 다른 봇 계정을 만들 것)
DISCORD_TOKEN=

# 쉼표 구분 Discord 사용자 ID
ALLOWED_USER_IDS=

# agy가 작업할 프로젝트 폴더 (절대경로 — codex 워크스페이스와 달라도 됨)
CODEX_WORKDIR=

# 엔진 선택: 이 인스턴스는 Antigravity CLI(agy)
ENGINE=agy

# 인스턴스별 데이터 폴더 (codex 인스턴스의 data/와 분리 필수)
DATA_DIR=data-gemini

# (선택) agy 바이너리 절대경로 — 미설정 시 PATH의 agy 사용
AGY_BIN=

# (선택) 이 인스턴스가 수신할 채널 ID (쉼표 구분). 비우면 모든 채널·DM 수신.
# 두 봇이 같은 채널에 있으면 일반 메시지에 둘 다 응답하므로, 전용 채널로 묶을 때 지정.
CHANNEL_IDS=
